  "programs": [
    {
      "name": "d2d_window",
      "purpose": "Create an HWND, own Direct2D resources, draw one primitive, resize and repaint.",
      "source_sets": [
        "direct2d_hello_window"
      ]
    },
    {
      "local_context": [
        "phase3/render/src/display_list.h",
        "phase3/render/src/display_list.cpp",
        "phase3/render/gdi/xaml_window.cpp"
      ],
      "name": "d2d_display_list",
      "purpose": "Replace the hard-wired primitive with OpenTerminal's existing display list.",
      "source_sets": [
        "direct2d_hello_window",
        "direct2d_device_resources"
      ]
    },
    {
      "name": "d2d_tree",
      "purpose": "Accumulate parent offsets, preserve z-order, transform children and apply a clip.",
      "source_sets": [
        "composition_visual_tree",
        "composition_layout_transforms"
      ]
    },
    {
      "name": "d2d_alpha",
      "purpose": "Render overlapping translucent subtrees and make layer composition observable.",
      "source_sets": [
        "composition_visual_tree",
        "composition_layout_transforms"
      ]
    },
    {
      "name": "dwrite_text",
      "purpose": "Create a text layout, draw it, then expose glyph runs through a custom renderer.",
      "source_sets": [
        "directwrite_hello",
        "directwrite_custom_renderer"
      ]
    },
    {
      "name": "dcomp_window",
      "purpose": "Attach a DirectComposition target and visual tree to an HWND and commit it.",
      "source_sets": [
        "directcomposition_hwnd",
        "composition_visual_tree"
      ]
    },
    {
      "local_context": [
        "phase3/layout/src/markup.cpp",
        "phase3/render/src/display_list.cpp"
      ],
      "name": "mini_xaml",
      "purpose": "Turn one declarative XAML object into layout and a display-list primitive.",
      "source_sets": [
        "xaml_minimal_object",
        "composition_xaml_interop"
      ]
    },
    {
      "local_context": [
        "phase3/layout/src/grid.cpp",
        "phase3/layout/src/stack_panel.cpp",
        "phase3/render/src/display_list.cpp"
      ],
      "name": "nested_xaml",
      "purpose": "Expand nested Grid, StackPanel, Border and text into an ordered visual tree.",
      "source_sets": [
        "xaml_nested_layout",
        "composition_xaml_interop"
      ]
    }
